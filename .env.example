# Copy to .env.local (gitignored) and fill in. Never commit real values.

# Supabase project URL.
# Deliberately NOT prefixed NEXT_PUBLIC_: nothing in the browser talks to
# Supabase, so there is no reason to publish the project ref into the JS bundle.
SUPABASE_URL=https://wfgsopxxxtpvteitobmr.supabase.co

# Service role / secret key. SERVER ONLY. Never prefix this with NEXT_PUBLIC_.
# Bypasses RLS, so treat it like a database password.
# Supabase dashboard: Project Settings > API Keys.
SUPABASE_SERVICE_ROLE_KEY=

# Salt for hashing visitor IPs before they reach the rate-limit table, so that
# table never holds a raw address. Any long random string; generate one with:
#   openssl rand -hex 32
# Changing it resets every open rate-limit window, which is harmless.
WAITLIST_IP_SALT=
